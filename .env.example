# Panel API (must match backend port; default is 3000 when running npm run dev)
VITE_API_BASE_URL="http://localhost:3000/api/v2"

# Turnstile (Cloudflare): disabled on localhost; set for production to protect auth pages
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAB3psFKWSOnZIl5T"
# Set to "true" to disable Turnstile even on non-localhost (e.g. staging)
VITE_DISABLE_TURNSTILE="false"

# Telegram Login Widget (same as main UI for social login)
VITE_TELEGRAM_BOT_USERNAME=void_smm_bot
VITE_TELEGRAM_BOT_ID=8574016204

# Google Sign-In (OAuth client ID, same as main UI)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Support page (Telegram DM and Email cards)
VITE_TELEGRAM_SUPPORT_USERNAME=void_panel_support
VITE_SUPPORT_EMAIL=void.panel.team+support@gmail.com
