# Production / build environment variables for void-proxy-ui
# Same as old UI (ui/.env). Copy to .env and set for your environment.

# API and UI URLs (required for prod so requests don't go to localhost)
VITE_API_BASE_URL=https://void-panel.com/api/v2
VITE_UI_BASE_URL=https://void-panel.com

# Optional: Telegram / Google if you use social login later
# VITE_TELEGRAM_BOT_USERNAME=void_smm_bot
# VITE_TELEGRAM_BOT_ID=8574016204
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
